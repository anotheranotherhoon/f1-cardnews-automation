# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# workflows/ 테스트 스크립트가 n8n 서버에 SSH 접속할 때 쓴다.
N8N_SSH_HOST=ubuntu@<서버주소>
N8N_SSH_KEY=<SSH 개인키 파일 경로>

# 캐릭터 자산 생성 (workflows/gen-assets.js).
# 환경변수가 없으면 ~/.gemini-key 파일에서 읽는다.
GEMINI_API_KEY=

# 그 외 키(Instagram, Telegram, Pexels)는 로컬에서 쓰지 않는다.
# 서버 n8n Credentials 에만 등록되어 있고, 워크플로는 ID로만 참조한다.
